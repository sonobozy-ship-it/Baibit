# ── Bybit API ─────────────────────────────────────────────────
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_TESTNET=false

# ── Anthropic (Claude AI) ──────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Telegram ───────────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── MySQL ──────────────────────────────────────────────────────
# Leave MYSQL_HOST empty to use SQLite instead
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=baibit
MYSQL_PASSWORD=strong_password_here
MYSQL_DATABASE=baibit

# ── News & Sentiment ───────────────────────────────────────────
CRYPTOPANIC_API_KEY=your_cryptopanic_key_here

# ── Bot Settings ───────────────────────────────────────────────
# Comma-separated list of symbols to trade
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# Paper trading mode (no real orders)
PAPER_TRADING=false
# Auto-start trading loop on backend startup (requires Bybit API or PAPER_TRADING=true)
AUTO_START=false
# Max leverage cap
MAX_LEVERAGE=5
# Adaptive learning window (number of trades per strategy)
ADAPTIVE_WINDOW=30
# OpenAI API (альтернатива Anthropic)
OPENAI_API_KEY=
# Ollama (локальная LLM, альтернатива Claude/GPT)
OLLAMA_BASE_URL=
