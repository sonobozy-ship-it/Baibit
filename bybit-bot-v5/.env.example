# ═══════════════════════════════════════════════════════════════
# BAIBIT TRADING BOT — КОНФИГУРАЦИЯ
# ВНИМАНИЕ: Это шаблон. Скопируй в .env и заполни свои значения.
# НЕ КОММИТЬ .env в git!
# ═══════════════════════════════════════════════════════════════

# ── Bybit API ──────────────────────────────────────────────────
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
# БЕЗОПАСНЫЙ ДЕФОЛТ: testnet=true. Для реала явно ставь false.
BYBIT_TESTNET=true

# ── Режим торговли ─────────────────────────────────────────────
# DRY_RUN   — вообще без ордеров, только логи
# PAPER     — виртуальная торговля (рекомендуется для старта)
# TESTNET   — реальные ордера на testnet-бирже
# LIVE      — реальные деньги (требует LIVE_TRADING_CONFIRM=true)
TRADING_MODE=PAPER

# Обратная совместимость (если TRADING_MODE не задан):
PAPER_TRADING=true

# ── Защита от случайной LIVE-торговли ─────────────────────────
# Чтобы запустить LIVE, оба флага должны быть true
LIVE_TRADING_CONFIRM=false
I_UNDERSTAND_REAL_MONEY_RISK=false

# ── Запуск ────────────────────────────────────────────────────
# false = бот не стартует автоматически, только по команде /start
AUTO_START=false

# ── AI / LLM ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=
OLLAMA_BASE_URL=

# ── Telegram ───────────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── База данных ────────────────────────────────────────────────
# Пусто = SQLite (data/baibit.db). Для MySQL раскомментируй:
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=baibit
# MYSQL_PASSWORD=strong_password_here
# MYSQL_DATABASE=baibit

# ── Новости и Sentiment ────────────────────────────────────────
CRYPTOPANIC_API_KEY=your_cryptopanic_key_here

# ── Риск-параметры ────────────────────────────────────────────
# Символы для торговли (запятая без пробелов)
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# Максимальное плечо (hard cap, биржа может ограничить меньше)
MAX_LEVERAGE=5
# Риск на сделку, % от депозита (hard cap, Kelly не превысит)
RISK_PER_TRADE_PCT=1.0
# Жёсткий кап риска в $ на сделку (0 = выключено). Рекомендуется 5.0
MAX_RISK_PER_TRADE_USDT=5.0
# Максимальный дневной убыток, % — жёсткий стоп на весь день
DAILY_MAX_LOSS_PCT=5.0
# Мягкий порог: при -3% пауза на 1 час (0 = выключено)
DAILY_PAUSE_LOSS_PCT=3.0
DAILY_PAUSE_HOURS=1.0
# Максимум убыточных сделок за день на стратегию
MAX_STRATEGY_DAILY_LOSSES=5
# Глобальный стоп по убыткам за день (0 = выключено)
MAX_DAILY_LOSSES=0
# Максимум открытых позиций одновременно
MAX_OPEN_POSITIONS=20

# ── ML-фильтр ─────────────────────────────────────────────────
# off       — не использовать ML
# advisory  — ML предупреждает, но не блокирует (рекомендуется)
# strict    — ML блокирует сигналы с низким P(win)
ML_FILTER_MODE=advisory

# ── Прочее ────────────────────────────────────────────────────
# Kelly Criterion для расчёта размера позиции
USE_KELLY=false
# Окно адаптации (сделок на стратегию)
ADAPTIVE_WINDOW=30
# Начальный баланс для paper-режима
PAPER_INITIAL_BALANCE=1000
